+  void _scheduleFocusCheck() {
+    if (_focusCheckScheduled || !mounted) return;
+    _focusCheckScheduled = true;
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      _focusCheckScheduled = false;
+      _checkFocus();
+    });
+  }
