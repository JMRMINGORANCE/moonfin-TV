+  static bool _routeIsCurrent(BuildContext context) =>
+      ModalRoute.of(context)?.isCurrent ?? true;
+
+  /// Un nodo real, con widget detrás, en la página de ajustes que está a la
+  /// vista. Lo que esté fuera del panel (otro diálogo encima) también vale.
+  bool _isUsableFocus(FocusNode? node) {
+    if (node == null || node is FocusScopeNode) return false;
+    final ctx = node.context;
+    if (ctx == null || !ctx.mounted) return false;
+    if (!node.ancestors.contains(_trapScope)) return true;
+    return _routeIsCurrent(ctx);
+  }
+
+  void _checkFocus() {
+    if (!mounted) return;
+    // Un selector u otro diálogo encima del panel tiene el foco: no tocar.
+    if (!_routeIsCurrent(context)) return;
+    final primary = FocusManager.instance.primaryFocus;
+    final lost = primary == null ||
+        primary.context == null ||
+        identical(primary, _trapScope) ||
+        (primary is FocusScopeNode && primary.ancestors.contains(_trapScope)) ||
+        (primary.ancestors.contains(_trapScope) && !_isUsableFocus(primary));
+    if (!lost) {
+      _focusRetries = 0;
+      return;
+    }
+    final target = _closestFocusable();
+    if (target != null) {
+      _focusRetries = 0;
+      target.requestFocus();
+      return;
+    }
+    // La página aún se está montando: se vuelve a mirar en el siguiente frame.
+    if (_focusRetries++ < 20) {
+      Future<void>.delayed(const Duration(milliseconds: 16), _scheduleFocusCheck);
+    }
+  }
+
+  FocusNode? _closestFocusable() {
+    final candidates = <FocusNode>[
+      for (final node in _trapScope.traversalDescendants)
+        if (node is! FocusScopeNode && _isUsableFocus(node)) node,
+    ];
+    if (candidates.isEmpty) return null;
+    final last = _lastFocusRect;
+    if (last == null) return candidates.first;
+    FocusNode best = candidates.first;
+    var bestDistance = double.infinity;
+    for (final node in candidates) {
+      final double distance;
+      try {
+        distance = (node.rect.center - last.center).distance;
+      } catch (_) {
+        continue;
+      }
+      if (distance < bestDistance) {
+        bestDistance = distance;
+        best = node;
+      }
+    }
+    return best;
+  }
