diff --git a/packages/app/src/views/Login/Login.module.less b/packages/app/src/views/Login/Login.module.less
index 3f8e443..c7f35c2 100644
--- a/packages/app/src/views/Login/Login.module.less
+++ b/packages/app/src/views/Login/Login.module.less
@@ -712,3 +712,129 @@
 .keyboardSpacerOpen {
 	height: 560px;
 }
+
+// ---------------------------------------------------------------------------
+// TaquitoFlix: fondo negro con un brillo rojo y «¿Quién está viendo?».
+// ---------------------------------------------------------------------------
+
+.page {
+	background: radial-gradient(ellipse at 50% 0%, #3a0306 0%, #120102 45%, #000000 80%);
+}
+
+.card {
+	background: rgba(20, 20, 20, 0.92);
+	border-color: rgba(255, 255, 255, 0.12);
+}
+
+.cineUsers {
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+	padding: 20px 0 40px 0;
+}
+
+.cineUsersTitle {
+	margin: 10px 0 60px 0;
+	font-size: 84px;
+	font-weight: 700;
+	color: #ffffff;
+	letter-spacing: -0.5px;
+}
+
+.cineUserRow {
+	display: flex;
+	flex-wrap: wrap;
+	justify-content: center;
+	max-width: 1600px;
+}
+
+.cineUser {
+	margin: 0 26px 40px 26px;
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+	outline: none;
+	cursor: pointer;
+	transition: transform 0.15s ease-out;
+
+	&:focus {
+		transform: scale(1.08);
+
+		.cineAvatar {
+			box-shadow: 0 0 0 6px #ffffff;
+		}
+
+		.cineUserName {
+			color: #ffffff;
+		}
+	}
+}
+
+.cineAvatar {
+	position: relative;
+	width: 220px;
+	height: 220px;
+	border-radius: 10px;
+	overflow: hidden;
+	display: flex;
+	align-items: flex-end;
+	justify-content: center;
+}
+
+.cineAvatarImg {
+	position: absolute;
+	top: 0;
+	left: 0;
+	width: 100%;
+	height: 100%;
+	object-fit: cover;
+}
+
+.cineAvatarTaquito {
+	width: 86%;
+	height: 86%;
+	margin-bottom: -6%;
+	object-fit: contain;
+	filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.35));
+}
+
+.cineUserName {
+	margin-top: 18px;
+	font-size: 34px;
+	color: #b3b3b3;
+}
+
+.cineUserActions {
+	display: flex;
+	margin-top: 30px;
+
+	> * {
+		margin: 0 16px;
+	}
+}
+
+.cineOutline {
+	height: 74px;
+	padding: 0 46px;
+	border: 3px solid #8c8c8c;
+	border-radius: 4px;
+	background: transparent;
+	color: #b3b3b3;
+	font-size: 30px;
+	letter-spacing: 2px;
+	text-transform: uppercase;
+	outline: none;
+	cursor: pointer;
+
+	&:focus {
+		border-color: #ffffff;
+		background: #ffffff;
+		color: #000000;
+	}
+}
+
+.cineServerName {
+	margin-top: 34px;
+	font-size: 24px;
+	color: #6d6d6d;
+}
