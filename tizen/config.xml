<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://josemingorance.es/taquitoflix" version="__VERSION__" viewmodes="maximized">
    <tizen:application id="TaquitoFlx.TaquitoFlix" package="TaquitoFlx" required_version="6.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>TaquitoFlix</name>
    <tizen:profile name="tv-samsung"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <!-- Sin esto la tele aplica "script-src 'self'; style-src 'self'": bloquea el
         motor de Flutter (gstatic), WebAssembly, los scripts en línea y hls.js. -->
    <tizen:content-security-policy>default-src * 'self' data: blob: filesystem: 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://www.gstatic.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https:; img-src * data: blob:; media-src * data: blob:; connect-src * data: blob:; font-src * data: blob:; worker-src 'self' blob:</tizen:content-security-policy>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="disable" encryption="disable"
                   install-location="auto" hwkey-event="enable"/>
</widget>
